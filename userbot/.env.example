# ---- Telegram API credentials (from https://my.telegram.org → API development tools) ----
TG_API_ID=123456
TG_API_HASH=your_api_hash_here

# Session storage. A file session (default) is easiest; a StringSession is handy
# for servers where you generate the string once elsewhere. Leave
# TG_SESSION_STRING empty to use the file session named by TG_SESSION.
TG_SESSION=cardxabar_userbot
TG_SESSION_STRING=

# The CardXabar bot/chat that forwards your incoming-payment notifications.
# Use its @username (without @) or numeric id. Comma-separate multiple sources.
CARDXABAR_SOURCE=CardXabar_bot

# Your deployed True Match backend (Railway) base URL — no trailing slash.
BACKEND_URL=https://your-backend.up.railway.app

# Must EXACTLY match the "Webhook secret" set in the admin panel
# (Settings → Card payment → Webhook secret).
PAYMENT_SECRET=paste-the-same-long-random-string-here

# Optional: only react to notifications that mention this card's last 4 digits.
CARD_LAST4=
