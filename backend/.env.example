# ===== Server =====
NODE_ENV=development
PORT=8080
# Comma-separated allowed origins for CORS (your frontend URL). "*" allows all.
CORS_ORIGIN=*

# ===== Database (Railway Postgres plugin) =====
# Railway provides this automatically as DATABASE_URL when you add the Postgres plugin.
DATABASE_URL=postgresql://user:password@host:5432/railway

# ===== Redis (Railway Redis plugin) =====
# Railway provides this as REDIS_URL when you add the Redis plugin.
# Leave empty for local dev without Redis (rate limiting/presence degrade gracefully).
REDIS_URL=

# ===== Telegram bot (grammy) =====
# From @BotFather
BOT_TOKEN=123456:ABC-DEF...
# Public URL of THIS backend (Railway domain). Used to register the webhook.
# e.g. https://true-match-backend.up.railway.app
BACKEND_URL=
# Deployed frontend Mini App URL (opened via the web_app button).
# e.g. https://true-match.pages.dev
MINI_APP_URL=
# Secret path segment for the webhook (any random string).
WEBHOOK_SECRET=change-this-to-a-random-string
# Telegram file_id of the demo video shown in the welcome message.
# Get it by sending a video to your bot and reading the file_id (see SETUP.md).
# Leave empty to send a text-only welcome for now.
WELCOME_VIDEO_FILE_ID=

# ===== Admin panel =====
# Password for /admin (Bearer token). Change this!
ADMIN_PASSWORD=change-this-admin-password

# ===== Cloudflare R2 (S3-compatible) =====
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=true-match-photos
# Public base URL for the bucket (R2 public dev URL or your custom domain),
# WITHOUT a trailing slash. e.g. https://pub-xxxx.r2.dev
R2_PUBLIC_BASE_URL=
